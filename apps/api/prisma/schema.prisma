// Prisma schema — Sprint 1: Identity, Authentication & Organization
// Organization is the tenant boundary; tenant-scoped rows use organizationId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Tenant root entity. All tenant-isolated data references Organization.id via organizationId.
model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  companies              Company[]
  branches               Branch[]
  customers              Customer[]
  customerSites          CustomerSite[]
  customerContacts       CustomerContact[]
  equipmentTypes         EquipmentType[]
  equipment              Equipment[]
  partCategories         PartCategory[]
  partSubcategories      PartSubcategory[]
  catalogParts           CatalogPart[]
  inventoryLocations     InventoryLocation[]
  inventoryItems         InventoryItem[]
  serviceCalls           ServiceCall[]
  serviceCallVisits      ServiceCallVisit[]
  serviceCallWorkReports ServiceCallWorkReport[]
  workflowEvents         WorkflowEvent[]
  userRoles              UserRole[]
  organizationMembers    OrganizationMember[]
  memberModuleAccess     MemberModuleAccess[]
  roles                  Role[]
  auditLogs              AuditLog[]
  workDays               WorkDay[]
  workBreaks             WorkBreak[]
  attendancePeriodLocks  AttendancePeriodLock[]
  workDayLocations       WorkDayLocation[]
  tasks                  Task[]
  numberSequences        OrganizationNumberSequence[]

  @@index([deletedAt])
  @@map("organizations")
}

/// Legal entity operating within an organization (tenant-scoped).
model Company {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  code           String
  legalName      String?
  taxId          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branches     Branch[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@map("companies")
}

/// Physical or logical site belonging to a company (tenant-scoped via organizationId).
model Branch {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  companyId      String    @db.Uuid
  name           String
  code           String
  addressLine1   String?
  city           String?
  country        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  equipment    Equipment[]
  serviceCalls ServiceCall[]

  @@unique([companyId, code])
  @@index([organizationId])
  @@index([companyId])
  @@index([organizationId, deletedAt])
  @@map("branches")
}

/// Global identity with credentials and profile.
model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String?
  displayName  String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  userRoles                  UserRole[]
  organizationMembers        OrganizationMember[]
  refreshTokens              RefreshToken[]
  auditLogs                  AuditLog[]              @relation("AuditActor")
  assignedServiceCalls       ServiceCall[]           @relation("AssignedTechnician")
  serviceCallVisits          ServiceCallVisit[]      @relation("VisitTechnician")
  assignedInventoryLocations InventoryLocation[]     @relation("AssignedInventoryLocationUser")
  serviceCallWorkReports     ServiceCallWorkReport[] @relation("WorkReportTechnician")
  workDays                   WorkDay[]
  approvedWorkDays           WorkDay[]               @relation("WorkDayApprover")
  lockedAttendancePeriods    AttendancePeriodLock[]  @relation("AttendancePeriodLocker")
  unlockedAttendancePeriods  AttendancePeriodLock[]  @relation("AttendancePeriodUnlocker")
  assignedTasks              Task[]                  @relation("TaskAssignee")
  createdTasks               Task[]                  @relation("TaskCreator")
  completedTasks             Task[]                  @relation("TaskCompleter")

  @@index([deletedAt])
  @@index([isActive])
  @@map("users")
}

/// System-wide permission definition (e.g. organizations:read).
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// Tenant-scoped role definition (admin, manager, technician, viewer, or custom).
model Role {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  slug           String
  description    String?
  isSystem       Boolean   @default(false)
  isOwner        Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userRoles           UserRole[]
  organizationMembers OrganizationMember[] @relation("MemberPrimaryRole")
  rolePermissions     RolePermission[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@map("roles")
}

/// Links a permission to a tenant-scoped role.
model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Links a User to an Organization with a Role (tenant-scoped user-role assignment).
model UserRole {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  userId         String    @db.Uuid
  roleId         String    @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId, roleId])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, deletedAt])
  @@map("user_roles")
}

enum OrganizationMemberStatus {
  ACTIVE
  SUSPENDED
}

/// Authoritative organization membership with modular access (one row per user per org).
model OrganizationMember {
  id                  String                   @id @default(uuid()) @db.Uuid
  organizationId      String                   @db.Uuid
  userId              String                   @db.Uuid
  primaryRoleId       String                   @db.Uuid
  isOrganizationOwner Boolean                  @default(false)
  status              OrganizationMemberStatus @default(ACTIVE)
  permissionsVersion  Int                      @default(1)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  deletedAt           DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  primaryRole  Role                 @relation("MemberPrimaryRole", fields: [primaryRoleId], references: [id], onDelete: Restrict)
  moduleAccess MemberModuleAccess[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, deletedAt])
  @@map("organization_members")
}

/// Per-member module entitlement (authoritative for non-owner users).
model MemberModuleAccess {
  id                   String   @id @default(uuid()) @db.Uuid
  organizationId       String   @db.Uuid
  organizationMemberId String   @db.Uuid
  moduleKey            String
  enabled              Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationMember OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)

  @@unique([organizationMemberId, moduleKey])
  @@index([organizationId])
  @@index([organizationMemberId])
  @@map("member_module_access")
}

/// Hashed refresh token for JWT session rotation.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

