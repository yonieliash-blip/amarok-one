// Prisma schema — Sprint 1: Identity, Authentication & Organization
// Organization is the tenant boundary; tenant-scoped rows use organizationId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Tenant root entity. All tenant-isolated data references Organization.id via organizationId.
model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  companies              Company[]
  branches               Branch[]
  customers              Customer[]
  customerSites          CustomerSite[]
  customerContacts       CustomerContact[]
  equipmentTypes         EquipmentType[]
  equipment              Equipment[]
  partCategories         PartCategory[]
  partSubcategories      PartSubcategory[]
  catalogParts           CatalogPart[]
  inventoryLocations     InventoryLocation[]
  inventoryItems         InventoryItem[]
  serviceCalls           ServiceCall[]
  serviceCallVisits      ServiceCallVisit[]
  serviceCallWorkReports ServiceCallWorkReport[]
  repairOrderAttachments ServiceCallWorkReportAttachment[]
  workflowEvents         WorkflowEvent[]
  userRoles              UserRole[]
  organizationMembers    OrganizationMember[]
  memberModuleAccess     MemberModuleAccess[]
  roles                  Role[]
  auditLogs              AuditLog[]
  workDays               WorkDay[]
  workBreaks             WorkBreak[]
  attendancePeriodLocks  AttendancePeriodLock[]
  workDayLocations       WorkDayLocation[]
  workDayActivitySamples WorkDayActivitySample[]
  tasks                  Task[]
  numberSequences        OrganizationNumberSequence[]
  directConversations    DirectConversation[]
  directMessages         DirectMessage[]
  technicianAvailability TechnicianAvailability[]
  inspirationQuotes      InspirationQuote[]
  employeeInspirations   EmployeeInspirationMessage[]
  documentCases          DocumentCase[]
  documentCaseDocuments  DocumentCaseDocument[]
  documentCaseVersions   DocumentCaseDocumentVersion[]
  documentCaseApprovals  DocumentCaseApproval[]
  documentCaseDeliveries DocumentCaseDelivery[]
  documentCaseTaskLinks  DocumentCaseTaskLink[]

  @@index([deletedAt])
  @@map("organizations")
}

/// Legal entity operating within an organization (tenant-scoped).
model Company {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  code           String
  legalName      String?
  taxId          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branches     Branch[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@map("companies")
}

/// Physical or logical site belonging to a company (tenant-scoped via organizationId).
model Branch {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  companyId      String    @db.Uuid
  name           String
  code           String
  addressLine1   String?
  city           String?
  country        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  equipment    Equipment[]
  serviceCalls ServiceCall[]

  @@unique([companyId, code])
  @@index([organizationId])
  @@index([companyId])
  @@index([organizationId, deletedAt])
  @@map("branches")
}

/// Global identity with credentials and profile.
model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String?
  displayName  String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  userRoles                  UserRole[]
  organizationMembers        OrganizationMember[]
  refreshTokens              RefreshToken[]
  auditLogs                  AuditLog[]                    @relation("AuditActor")
  assignedServiceCalls       ServiceCall[]                 @relation("AssignedTechnician")
  serviceCallVisits          ServiceCallVisit[]            @relation("VisitTechnician")
  assignedInventoryLocations InventoryLocation[]           @relation("AssignedInventoryLocationUser")
  serviceCallWorkReports     ServiceCallWorkReport[]       @relation("WorkReportTechnician")
  workDays                   WorkDay[]
  approvedWorkDays           WorkDay[]                     @relation("WorkDayApprover")
  lockedAttendancePeriods    AttendancePeriodLock[]        @relation("AttendancePeriodLocker")
  unlockedAttendancePeriods  AttendancePeriodLock[]        @relation("AttendancePeriodUnlocker")
  assignedTasks              Task[]                        @relation("TaskAssignee")
  createdTasks               Task[]                        @relation("TaskCreator")
  completedTasks             Task[]                        @relation("TaskCompleter")
  directConversationsFirst   DirectConversation[]          @relation("DirectConversationParticipantOne")
  directConversationsSecond  DirectConversation[]          @relation("DirectConversationParticipantTwo")
  sentDirectMessages         DirectMessage[]               @relation("DirectMessageSender")
  technicianAvailability     TechnicianAvailability[]      @relation("TechnicianAvailabilityUser")
  inspirationMessages        EmployeeInspirationMessage[]  @relation("EmployeeInspirationRecipient")
  managedDocumentCases       DocumentCase[]                @relation("DocumentCaseManager")
  secretarialDocumentCases   DocumentCase[]                @relation("DocumentCaseSecretary")
  archivedDocumentCases      DocumentCase[]                @relation("DocumentCaseArchiver")
  createdDocumentVersions    DocumentCaseDocumentVersion[] @relation("DocumentVersionCreator")
  documentApprovals          DocumentCaseApproval[]        @relation("DocumentApprovalDecider")
  sentDocumentDeliveries     DocumentCaseDelivery[]        @relation("DocumentDeliverySender")

  @@index([deletedAt])
  @@index([isActive])
  @@map("users")
}

/// System-wide permission definition (e.g. organizations:read).
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// Tenant-scoped role definition (admin, manager, technician, viewer, or custom).
model Role {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  slug           String
  description    String?
  isSystem       Boolean   @default(false)
  isOwner        Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userRoles           UserRole[]
  organizationMembers OrganizationMember[] @relation("MemberPrimaryRole")
  rolePermissions     RolePermission[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@map("roles")
}

/// Links a permission to a tenant-scoped role.
model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Links a User to an Organization with a Role (tenant-scoped user-role assignment).
model UserRole {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  userId         String    @db.Uuid
  roleId         String    @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId, roleId])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, deletedAt])
  @@map("user_roles")
}

enum OrganizationMemberStatus {
  ACTIVE
  SUSPENDED
}

/// Authoritative organization membership with modular access (one row per user per org).
model OrganizationMember {
  id                  String                   @id @default(uuid()) @db.Uuid
  organizationId      String                   @db.Uuid
  userId              String                   @db.Uuid
  primaryRoleId       String                   @db.Uuid
  isOrganizationOwner Boolean                  @default(false)
  status              OrganizationMemberStatus @default(ACTIVE)
  permissionsVersion  Int                      @default(1)
  birthDate           DateTime?                @db.Date
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  deletedAt           DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  primaryRole  Role                 @relation("MemberPrimaryRole", fields: [primaryRoleId], references: [id], onDelete: Restrict)
  moduleAccess MemberModuleAccess[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, deletedAt])
  @@map("organization_members")
}

enum TechnicianAvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
}

/// A dispatcher-managed, per-day availability override for an active technician.
/// Missing rows mean the technician has not been marked unavailable for that day.
model TechnicianAvailability {
  id             String                       @id @default(uuid()) @db.Uuid
  organizationId String                       @db.Uuid
  technicianId   String                       @db.Uuid
  date           DateTime                     @db.Date
  status         TechnicianAvailabilityStatus @default(AVAILABLE)
  note           String?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  technician   User         @relation("TechnicianAvailabilityUser", fields: [technicianId], references: [id], onDelete: Restrict)

  @@unique([organizationId, technicianId, date])
  @@index([organizationId, date])
  @@index([organizationId, technicianId, date])
  @@map("technician_availability")
}

/// Manager-curated quote/proverb available to the organization's dashboards.
model InspirationQuote {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  text           String
  author         String?
  isActive       Boolean  @default(true)
  createdById    String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, isActive])
  @@index([organizationId, createdAt])
  @@map("inspiration_quotes")
}

/// A private manager message which overrides the general quote for one employee.
model EmployeeInspirationMessage {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  text           String
  isActive       Boolean  @default(true)
  createdById    String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation("EmployeeInspirationRecipient", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([organizationId, isActive])
  @@map("employee_inspiration_messages")
}

/// One private, tenant-scoped conversation between exactly two active organization users.
/// Participant IDs are stored in canonical order to prevent duplicate conversations.
model DirectConversation {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @db.Uuid
  participantOneId String    @db.Uuid
  participantTwoId String    @db.Uuid
  lastMessageAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  participantOne User            @relation("DirectConversationParticipantOne", fields: [participantOneId], references: [id], onDelete: Restrict)
  participantTwo User            @relation("DirectConversationParticipantTwo", fields: [participantTwoId], references: [id], onDelete: Restrict)
  messages       DirectMessage[]

  @@unique([organizationId, participantOneId, participantTwoId])
  @@index([organizationId, lastMessageAt])
  @@index([organizationId, participantOneId])
  @@index([organizationId, participantTwoId])
  @@map("direct_conversations")
}

/// Immutable text message in a private organization conversation.
model DirectMessage {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  conversationId String    @db.Uuid
  senderId       String    @db.Uuid
  body           String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  conversation DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  sender       User               @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([organizationId, conversationId, createdAt])
  @@index([organizationId, senderId])
  @@map("direct_messages")
}

/// Per-member module entitlement (authoritative for non-owner users).
model MemberModuleAccess {
  id                   String   @id @default(uuid()) @db.Uuid
  organizationId       String   @db.Uuid
  organizationMemberId String   @db.Uuid
  moduleKey            String
  enabled              Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationMember OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)

  @@unique([organizationMemberId, moduleKey])
  @@index([organizationId])
  @@index([organizationMemberId])
  @@map("member_module_access")
}

/// Hashed refresh token for JWT session rotation.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Append-only audit trail. Never updated or soft-deleted.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  actorId        String?  @db.Uuid
  action         String
  entityType     String
  entityId       String   @db.Uuid
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  WAITING
  COMPLETED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Organization-scoped office task. Completion remains auditable and reversible.
model Task {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @db.Uuid
  title            String
  description      String?
  status           TaskStatus   @default(OPEN)
  priority         TaskPriority @default(NORMAL)
  dueAt            DateTime?
  assignedToId     String       @db.Uuid
  createdById      String?      @db.Uuid
  completedAt      DateTime?
  completedById    String?      @db.Uuid
  completionNote   String?
  linkUrl          String?
  linkedEntityType String?
  linkedEntityId   String?      @db.Uuid
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignedTo        User                   @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  createdBy         User?                  @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  completedBy       User?                  @relation("TaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  documentCaseLinks DocumentCaseTaskLink[]

  @@index([organizationId, assignedToId, status])
  @@index([organizationId, dueAt])
  @@map("tasks")
}

enum WorkDayStatus {
  ACTIVE
  COMPLETED
}

enum WorkBreakStatus {
  ACTIVE
  COMPLETED
}

enum AttendanceReviewStatus {
  PENDING
  APPROVED
}

/// Employee-owned attendance record. Location is captured only at explicit clock actions.
model WorkDay {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @db.Uuid
  userId         String                 @db.Uuid
  status         WorkDayStatus          @default(ACTIVE)
  startedAt      DateTime
  startLatitude  Decimal?               @db.Decimal(9, 6)
  startLongitude Decimal?               @db.Decimal(9, 6)
  startAccuracy  Float?
  endedAt        DateTime?
  endLatitude    Decimal?               @db.Decimal(9, 6)
  endLongitude   Decimal?               @db.Decimal(9, 6)
  endAccuracy    Float?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  reviewStatus   AttendanceReviewStatus @default(PENDING)
  approvedAt     DateTime?
  approvedById   String?                @db.Uuid

  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user            User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  approvedBy      User?                   @relation("WorkDayApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  breaks          WorkBreak[]
  locations       WorkDayLocation[]
  activitySamples WorkDayActivitySample[]

  @@index([organizationId, userId, startedAt])
  @@index([organizationId, status])
  @@index([organizationId, reviewStatus])
  @@map("work_days")
}

model WorkBreak {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  workDayId      String          @db.Uuid
  status         WorkBreakStatus @default(ACTIVE)
  startedAt      DateTime
  startLatitude  Decimal?        @db.Decimal(9, 6)
  startLongitude Decimal?        @db.Decimal(9, 6)
  startAccuracy  Float?
  endedAt        DateTime?
  endLatitude    Decimal?        @db.Decimal(9, 6)
  endLongitude   Decimal?        @db.Decimal(9, 6)
  endAccuracy    Float?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workDay      WorkDay      @relation(fields: [workDayId], references: [id], onDelete: Restrict)

  @@index([organizationId, workDayId])
  @@index([organizationId, status])
  @@map("work_breaks")
}

/// A sampled employee location accepted only during that employee's active work day.
model WorkDayLocation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  workDayId      String   @db.Uuid
  recordedAt     DateTime
  latitude       Decimal  @db.Decimal(9, 6)
  longitude      Decimal  @db.Decimal(9, 6)
  accuracy       Float?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workDay      WorkDay      @relation(fields: [workDayId], references: [id], onDelete: Cascade)

  @@unique([workDayId, recordedAt])
  @@index([organizationId, workDayId, recordedAt])
  @@map("work_day_locations")
}

/// A lightweight in-app activity heartbeat during an active work day.
/// It records interaction with AMAROK ONE only and is never used to alter payable work hours.
model WorkDayActivitySample {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  workDayId      String   @db.Uuid
  recordedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workDay      WorkDay      @relation(fields: [workDayId], references: [id], onDelete: Cascade)

  @@index([organizationId, workDayId, recordedAt])
  @@map("work_day_activity_samples")
}

/// Tenant-scoped payroll boundary. An active lock has no unlockedAt value.
model AttendancePeriodLock {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  month          String
  lockedAt       DateTime  @default(now())
  lockedById     String    @db.Uuid
  unlockedAt     DateTime?
  unlockedById   String?   @db.Uuid
  unlockReason   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lockedBy     User         @relation("AttendancePeriodLocker", fields: [lockedById], references: [id], onDelete: Restrict)
  unlockedBy   User?        @relation("AttendancePeriodUnlocker", fields: [unlockedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, month])
  @@index([organizationId, unlockedAt])
  @@map("attendance_period_locks")
}

/// Customer lifecycle status.
enum CustomerStatus {
  ACTIVE
  INACTIVE
  PROSPECT
}

/// Tenant-scoped customer account.
model Customer {
  id                     String         @id @default(uuid()) @db.Uuid
  organizationId         String         @db.Uuid
  name                   String
  legalName              String?
  registrationNumber     String?
  customerNumber         String
  externalCustomerNumber String?
  morningClientId        String?
  morningLastSyncedAt    DateTime?
  email                  String?
  phone                  String?
  address                String?
  city                   String?
  country                String?
  notes                  String?
  status                 CustomerStatus @default(ACTIVE)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  deletedAt              DateTime?

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contacts      CustomerContact[]
  sites         CustomerSite[]
  equipment     Equipment[]
  serviceCalls  ServiceCall[]
  documentCases DocumentCase[]

  @@unique([organizationId, morningClientId])
  // The database enforces this as a partial unique index for active rows only.
  // Soft-deleted historical customers keep their original number for auditability.
  @@index([organizationId, customerNumber], map: "customers_organizationId_customerNumber_active_key")
  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@index([organizationId, status])
  @@map("customers")
}

/// Per-organization counters for human-facing operational references.
/// A counter is reserved inside the same transaction as its target entity.
model OrganizationNumberSequence {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  scope          String
  nextValue      Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, scope])
  @@index([organizationId])
  @@map("organization_number_sequences")
}

/// Physical work site under a billing customer (for example, a quarry or plant).
model CustomerSite {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  customerId     String    @db.Uuid
  name           String
  address        String?
  city           String?
  contactName    String?
  contactPhone   String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contacts     CustomerContact[]
  equipment    Equipment[]
  serviceCalls ServiceCall[]

  @@index([organizationId])
  @@index([customerId, deletedAt])
  @@map("customer_sites")
}

/// Contact person belonging to a customer (tenant-scoped).
model CustomerContact {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @db.Uuid
  customerId       String    @db.Uuid
  customerSiteId   String?   @db.Uuid
  name             String
  email            String?
  phone            String?
  jobTitle         String?
  morningSourceKey String?
  isPrimary        Boolean   @default(false)
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerSite CustomerSite? @relation(fields: [customerSiteId], references: [id], onDelete: SetNull)

  @@unique([customerId, morningSourceKey])
  @@index([organizationId])
  @@index([customerId])
  @@index([customerId, deletedAt])
  @@index([customerSiteId])
  @@map("customer_contacts")
}

/// Equipment operational status.
enum EquipmentStatus {
  ACTIVE
  IN_SERVICE
  OUT_OF_SERVICE
  RETIRED
}

/// Tenant-scoped equipment category (forklift, crane, excavator, etc.).
model EquipmentType {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  code           String
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  equipment    Equipment[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@map("equipment_types")
}

/// Tenant-scoped equipment asset (machine, vehicle, or tool).
model Equipment {
  id                 String          @id @default(uuid()) @db.Uuid
  organizationId     String          @db.Uuid
  equipmentTypeId    String          @db.Uuid
  customerId         String?         @db.Uuid
  customerSiteId     String?         @db.Uuid
  branchId           String?         @db.Uuid
  name               String
  internalNumber     String
  serialNumber       String?
  manufacturer       String?
  model              String?
  year               Int?
  status             EquipmentStatus @default(ACTIVE)
  engineHours        Decimal?        @db.Decimal(10, 2)
  mileage            Int?
  registrationNumber String?
  warrantyEndDate    DateTime?       @db.Date
  location           String?
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  equipmentType EquipmentType @relation(fields: [equipmentTypeId], references: [id], onDelete: Restrict)
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerSite  CustomerSite? @relation(fields: [customerSiteId], references: [id], onDelete: SetNull)
  branch        Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  serviceCalls  ServiceCall[]

  @@unique([organizationId, internalNumber])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@index([organizationId, customerSiteId])
  @@index([organizationId, equipmentTypeId])
  @@index([organizationId, manufacturer])
  @@index([organizationId, model])
  @@map("equipment")
}

/// Service call lifecycle status.
enum ServiceCallStatus {
  OPEN
  SCHEDULED
  IN_PROGRESS
  WAITING_FOR_PARTS
  COMPLETED
  CANCELLED
}

/// Service call urgency level.
enum ServiceCallPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Control-center lifecycle (Sprint 4).
enum ServiceCallLifecycleState {
  NEW
  WAITING_ASSIGNMENT
  ASSIGNED
  DRIVING
  WORKING
  WAITING_FOR_PARTS
  WAITING_CUSTOMER
  WAITING_SPECIALIST
  WAITING_MANAGER_CLOSURE
  CLOSED
}

/// Technician visit status within a service call.
enum ServiceCallVisitStatus {
  PLANNED
  ASSIGNED
  DRIVING
  WORKING
  FINISHED
  CANCELLED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
}

enum InventoryLocationType {
  SERVICE_VAN
  CENTRAL_WAREHOUSE
}

/// Tenant-scoped field service work order.
model ServiceCall {
  id                     String                    @id @default(uuid()) @db.Uuid
  organizationId         String                    @db.Uuid
  serviceCallNumber      String
  title                  String
  description            String?
  status                 ServiceCallStatus         @default(OPEN)
  lifecycleState         ServiceCallLifecycleState @default(NEW)
  priority               ServiceCallPriority       @default(NORMAL)
  openedAt               DateTime                  @default(now())
  scheduledAt            DateTime?
  completedAt            DateTime?
  customerId             String                    @db.Uuid
  customerSiteId         String?                   @db.Uuid
  // A call may describe a one-off vehicle/tool without creating permanent equipment.
  equipmentId            String?                   @db.Uuid
  branchId               String?                   @db.Uuid
  assignedUserId         String?                   @db.Uuid
  contactName            String?
  contactPhone           String?
  location               String?
  equipmentModel         String?
  equipmentLicensePlate  String?
  equipmentChassisNumber String?
  purchaseOrderNumber    String?
  notes                  String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  deletedAt              DateTime?

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerSite CustomerSite?           @relation(fields: [customerSiteId], references: [id], onDelete: SetNull)
  equipment    Equipment?              @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  branch       Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)
  assignedUser User?                   @relation("AssignedTechnician", fields: [assignedUserId], references: [id], onDelete: SetNull)
  visits       ServiceCallVisit[]
  workReports  ServiceCallWorkReport[]

  @@unique([organizationId, serviceCallNumber])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, customerId])
  @@index([organizationId, customerSiteId])
  @@index([organizationId, equipmentId])
  @@index([organizationId, assignedUserId])
  @@index([organizationId, openedAt])
  @@map("service_calls")
}

/// Technician visit on a service call (operational store; workflow events remain source of truth for transitions).
model ServiceCallVisit {
  id               String                 @id @default(uuid()) @db.Uuid
  organizationId   String                 @db.Uuid
  serviceCallId    String                 @db.Uuid
  technicianId     String                 @db.Uuid
  sequence         Int
  status           ServiceCallVisitStatus @default(ASSIGNED)
  scheduledStart   DateTime?
  scheduledEnd     DateTime?
  drivingStartedAt DateTime?
  workingStartedAt DateTime?
  finishedAt       DateTime?
  notes            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  deletedAt        DateTime?

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  serviceCall  ServiceCall            @relation(fields: [serviceCallId], references: [id], onDelete: Restrict)
  technician   User                   @relation("VisitTechnician", fields: [technicianId], references: [id], onDelete: Restrict)
  workReport   ServiceCallWorkReport?

  @@unique([serviceCallId, sequence])
  @@index([organizationId])
  @@index([organizationId, serviceCallId])
  @@index([organizationId, technicianId])
  @@index([organizationId, deletedAt])
  @@map("service_call_visits")
}

model PartCategory {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subcategories PartSubcategory[]
  catalogParts  CatalogPart[]

  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@map("part_categories")
}

model PartSubcategory {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  categoryId     String    @db.Uuid
  name           String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category     PartCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  catalogParts CatalogPart[]

  @@index([organizationId])
  @@index([categoryId])
  @@index([organizationId, deletedAt])
  @@map("part_subcategories")
}

model CatalogPart {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  categoryId     String    @db.Uuid
  subcategoryId  String    @db.Uuid
  name           String
  partNumber     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization    Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category        PartCategory                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory     PartSubcategory             @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  inventoryItems  InventoryItem[]
  workReportParts ServiceCallWorkReportPart[]

  @@index([organizationId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([organizationId, deletedAt])
  @@map("catalog_parts")
}

model InventoryLocation {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @db.Uuid
  name           String
  type           InventoryLocationType
  assignedUserId String?               @db.Uuid
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignedUser User?           @relation("AssignedInventoryLocationUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  items        InventoryItem[]

  @@index([organizationId])
  @@index([organizationId, type])
  @@index([assignedUserId])
  @@index([organizationId, deletedAt])
  @@map("inventory_locations")
}

model InventoryItem {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  locationId     String    @db.Uuid
  partId         String    @db.Uuid
  quantity       Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization    Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location        InventoryLocation           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  part            CatalogPart                 @relation(fields: [partId], references: [id], onDelete: Restrict)
  workReportParts ServiceCallWorkReportPart[]

  @@index([organizationId])
  @@index([locationId])
  @@index([partId])
  @@index([organizationId, deletedAt])
  @@map("inventory_items")
}

model ServiceCallWorkReport {
  id                    String    @id @default(uuid()) @db.Uuid
  organizationId        String    @db.Uuid
  serviceCallId         String    @db.Uuid
  visitId               String    @unique @db.Uuid
  technicianId          String    @db.Uuid
  workPerformed         String?
  customerName          String?
  customerSignatureData String?
  signedAt              DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  organization         Organization                      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  serviceCall          ServiceCall                       @relation(fields: [serviceCallId], references: [id], onDelete: Restrict)
  visit                ServiceCallVisit                  @relation(fields: [visitId], references: [id], onDelete: Restrict)
  technician           User                              @relation("WorkReportTechnician", fields: [technicianId], references: [id], onDelete: Restrict)
  parts                ServiceCallWorkReportPart[]
  attachments          ServiceCallWorkReportAttachment[]
  documentCaseVersions DocumentCaseDocumentVersion[]

  @@index([organizationId])
  @@index([serviceCallId])
  @@index([technicianId])
  @@index([organizationId, deletedAt])
  @@map("service_call_work_reports")
}

enum DocumentCaseWorkflow {
  DIRECT_INVOICE
  QUOTE_AND_PURCHASE_ORDER
}

enum DocumentCaseStatus {
  DRAFT
  QUOTE_REVIEW_REQUIRED
  QUOTE_CORRECTION_REQUIRED
  QUOTE_SEND_REQUIRED
  WAITING_PURCHASE_ORDER
  INVOICE_REVIEW_REQUIRED
  INVOICE_CORRECTION_REQUIRED
  INVOICE_SEND_REQUIRED
  ARCHIVED
}

enum DocumentCaseDocumentType {
  WORK_REPORT
  QUOTE
  PURCHASE_ORDER
  INVOICE
}

enum DocumentVersionSource {
  METADATA_ONLY
  EXISTING_WORK_REPORT
}

enum DocumentApprovalDecision {
  APPROVED
  RETURNED_FOR_CORRECTION
}

enum DocumentDeliveryChannel {
  EMAIL
  WHATSAPP
  OTHER
}

enum DocumentCaseTaskKind {
  MANAGER_REVIEW
  SECRETARY_SEND
  SECRETARY_PURCHASE_ORDER
}

model DocumentCase {
  id                  String                 @id @default(uuid()) @db.Uuid
  organizationId      String                 @db.Uuid
  customerId          String                 @db.Uuid
  repairReportNumber  String
  workflow            DocumentCaseWorkflow
  status              DocumentCaseStatus     @default(DRAFT)
  managerAssigneeId   String                 @db.Uuid
  secretaryAssigneeId String                 @db.Uuid
  archivedAt          DateTime?
  archivedById        String?                @db.Uuid
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer            Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  manager             User                   @relation("DocumentCaseManager", fields: [managerAssigneeId], references: [id], onDelete: Restrict)
  secretary           User                   @relation("DocumentCaseSecretary", fields: [secretaryAssigneeId], references: [id], onDelete: Restrict)
  archivedBy          User?                  @relation("DocumentCaseArchiver", fields: [archivedById], references: [id], onDelete: SetNull)
  documents           DocumentCaseDocument[]
  approvals           DocumentCaseApproval[]
  deliveries          DocumentCaseDelivery[]
  taskLinks           DocumentCaseTaskLink[]

  @@unique([organizationId, repairReportNumber])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@index([organizationId, archivedAt])
  @@map("document_cases")
}

model DocumentCaseDocument {
  id             String                        @id @default(uuid()) @db.Uuid
  organizationId String                        @db.Uuid
  documentCaseId String                        @db.Uuid
  type           DocumentCaseDocumentType
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  organization   Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  documentCase   DocumentCase                  @relation(fields: [documentCaseId], references: [id], onDelete: Restrict)
  versions       DocumentCaseDocumentVersion[]

  @@unique([documentCaseId, type])
  @@index([organizationId, documentCaseId])
  @@map("document_case_documents")
}

model DocumentCaseDocumentVersion {
  id                     String                     @id @default(uuid()) @db.Uuid
  organizationId         String                     @db.Uuid
  documentId             String                     @db.Uuid
  versionNumber          Int
  source                 DocumentVersionSource      @default(METADATA_ONLY)
  sourceWorkReportId     String?                    @db.Uuid
  displayName            String
  externalDocumentNumber String?
  documentDate           DateTime?                  @db.Date
  note                   String?
  createdById            String?                    @db.Uuid
  createdAt              DateTime                   @default(now())
  organization           Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  document               DocumentCaseDocument       @relation(fields: [documentId], references: [id], onDelete: Restrict)
  sourceWorkReport       ServiceCallWorkReport?     @relation(fields: [sourceWorkReportId], references: [id], onDelete: Restrict)
  createdBy              User?                      @relation("DocumentVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approval               DocumentCaseApproval?
  deliveryItems          DocumentCaseDeliveryItem[]
  taskLinks              DocumentCaseTaskLink[]

  @@unique([documentId, versionNumber])
  @@index([organizationId, documentId, createdAt])
  @@index([sourceWorkReportId])
  @@map("document_case_document_versions")
}

model DocumentCaseApproval {
  id                String                      @id @default(uuid()) @db.Uuid
  organizationId    String                      @db.Uuid
  documentCaseId    String                      @db.Uuid
  documentVersionId String                      @unique @db.Uuid
  decision          DocumentApprovalDecision
  note              String?
  decidedById       String                      @db.Uuid
  decidedAt         DateTime                    @default(now())
  createdAt         DateTime                    @default(now())
  organization      Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  documentCase      DocumentCase                @relation(fields: [documentCaseId], references: [id], onDelete: Restrict)
  documentVersion   DocumentCaseDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  decidedBy         User                        @relation("DocumentApprovalDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([organizationId, documentCaseId, decidedAt])
  @@map("document_case_approvals")
}

model DocumentCaseDelivery {
  id             String                     @id @default(uuid()) @db.Uuid
  organizationId String                     @db.Uuid
  documentCaseId String                     @db.Uuid
  sentById       String                     @db.Uuid
  recipientName  String
  recipientEmail String?
  recipientPhone String?
  channel        DocumentDeliveryChannel
  note           String?
  sentAt         DateTime
  createdAt      DateTime                   @default(now())
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  documentCase   DocumentCase               @relation(fields: [documentCaseId], references: [id], onDelete: Restrict)
  sentBy         User                       @relation("DocumentDeliverySender", fields: [sentById], references: [id], onDelete: Restrict)
  items          DocumentCaseDeliveryItem[]

  @@index([organizationId, documentCaseId, sentAt])
  @@map("document_case_deliveries")
}

model DocumentCaseDeliveryItem {
  id                String                      @id @default(uuid()) @db.Uuid
  deliveryId        String                      @db.Uuid
  documentVersionId String                      @db.Uuid
  createdAt         DateTime                    @default(now())
  delivery          DocumentCaseDelivery        @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  documentVersion   DocumentCaseDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)

  @@unique([deliveryId, documentVersionId])
  @@index([documentVersionId])
  @@map("document_case_delivery_items")
}

model DocumentCaseTaskLink {
  id                String                       @id @default(uuid()) @db.Uuid
  organizationId    String                       @db.Uuid
  documentCaseId    String                       @db.Uuid
  taskId            String                       @unique @db.Uuid
  taskKind          DocumentCaseTaskKind
  documentVersionId String?                      @db.Uuid
  deduplicationKey  String
  resolvedAt        DateTime?
  createdAt         DateTime                     @default(now())
  organization      Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  documentCase      DocumentCase                 @relation(fields: [documentCaseId], references: [id], onDelete: Restrict)
  task              Task                         @relation(fields: [taskId], references: [id], onDelete: Restrict)
  documentVersion   DocumentCaseDocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)

  @@unique([organizationId, deduplicationKey])
  @@index([organizationId, documentCaseId, taskKind, resolvedAt])
  @@map("document_case_task_links")
}

/// Private photo metadata for a repair order. Object bytes are stored in the configured private bucket.
model ServiceCallWorkReportAttachment {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  workReportId   String    @db.Uuid
  category       String
  storageKey     String    @unique
  fileName       String
  contentType    String
  byteSize       Int
  createdById    String    @db.Uuid
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workReport   ServiceCallWorkReport @relation(fields: [workReportId], references: [id], onDelete: Cascade)

  @@index([organizationId, workReportId, deletedAt])
  @@map("service_call_work_report_attachments")
}

model ServiceCallWorkReportPart {
  id               String   @id @default(uuid()) @db.Uuid
  workReportId     String   @db.Uuid
  inventoryItemId  String?  @db.Uuid
  catalogPartId    String?  @db.Uuid
  manualName       String?
  manualPartNumber String?
  quantity         Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workReport    ServiceCallWorkReport @relation(fields: [workReportId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem?        @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  catalogPart   CatalogPart?          @relation(fields: [catalogPartId], references: [id], onDelete: Restrict)

  @@index([workReportId])
  @@index([inventoryItemId])
  @@index([catalogPartId])
  @@map("service_call_work_report_parts")
}

/// Append-only workflow event stream (service-call aggregate).
model WorkflowEvent {
  id             String   @id @db.Uuid
  organizationId String   @db.Uuid
  aggregateType  String
  aggregateId    String   @db.Uuid
  type           String
  payload        Json
  occurredAt     DateTime
  actorId        String?  @db.Uuid
  correlationId  String
  causationId    String?  @db.Uuid
  sequence       Int
  idempotencyKey String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, aggregateId, sequence])
  @@index([organizationId, aggregateId])
  @@index([organizationId, idempotencyKey])
  @@map("workflow_events")
}
