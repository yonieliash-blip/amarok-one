// Prisma schema — Sprint 1: Identity, Authentication & Organization
// Organization is the tenant boundary; tenant-scoped rows use organizationId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Tenant root entity. All tenant-isolated data references Organization.id via organizationId.
model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  companies             Company[]
  branches              Branch[]
  customers             Customer[]
  customerContacts      CustomerContact[]
  customerSites         CustomerSite[]
  equipmentTypes        EquipmentType[]
  equipmentManufacturers EquipmentManufacturer[]
  equipmentModels       EquipmentCatalogModel[]
  equipment             Equipment[]
  workReportPartCategories WorkReportPartCategory[]
  workReportParts       WorkReportPart[]
  workReports           WorkReport[]
  workReportMedia       WorkReportMedia[]
  stockLocations        StockLocation[]
  inventoryItems        InventoryItem[]
  serviceCalls          ServiceCall[]
  serviceCallVisits     ServiceCallVisit[]
  workflowEvents        WorkflowEvent[]
  userRoles             UserRole[]
  organizationMembers   OrganizationMember[]
  memberModuleAccess    MemberModuleAccess[]
  roles                 Role[]
  auditLogs             AuditLog[]
  workDays              WorkDay[]
  workBreaks            WorkBreak[]
  attendancePeriodLocks AttendancePeriodLock[]
  workDayLocations      WorkDayLocation[]

  @@index([deletedAt])
  @@map("organizations")
}

/// A physical parts location: the central warehouse or one of the service vehicles.
model StockLocation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  kind           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  items        InventoryItem[]

  @@unique([organizationId, name])
  @@index([organizationId, kind, deletedAt])
  @@map("stock_locations")
}

/// Quantity of a named spare part held at one physical parts location.
model InventoryItem {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  stockLocationId String   @db.Uuid
  name            String
  partNumber      String?
  quantity        Decimal  @default(0) @db.Decimal(12, 3)
  unit            String   @default("יח׳")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  stockLocation StockLocation @relation(fields: [stockLocationId], references: [id], onDelete: Cascade)

  @@index([organizationId, stockLocationId, deletedAt])
  @@map("inventory_items")
}

/// Legal entity operating within an organization (tenant-scoped).
model Company {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  code           String
  legalName      String?
  taxId          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branches     Branch[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@map("companies")
}

/// Physical or logical site belonging to a company (tenant-scoped via organizationId).
model Branch {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  companyId      String    @db.Uuid
  name           String
  code           String
  addressLine1   String?
  city           String?
  country        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  equipment    Equipment[]
  serviceCalls ServiceCall[]

  @@unique([companyId, code])
  @@index([organizationId])
  @@index([companyId])
  @@index([organizationId, deletedAt])
  @@map("branches")
}

/// Global identity with credentials and profile.
model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String?
  displayName  String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  userRoles                 UserRole[]
  organizationMembers       OrganizationMember[]
  refreshTokens             RefreshToken[]
  auditLogs                 AuditLog[]             @relation("AuditActor")
  assignedServiceCalls      ServiceCall[]          @relation("AssignedTechnician")
  serviceCallVisits         ServiceCallVisit[]     @relation("VisitTechnician")
  authoredWorkReports       WorkReport[]           @relation("WorkReportTechnician")
  editedWorkReports         WorkReport[]           @relation("WorkReportEditor")
  workDays                  WorkDay[]
  approvedWorkDays          WorkDay[]              @relation("WorkDayApprover")
  lockedAttendancePeriods   AttendancePeriodLock[] @relation("AttendancePeriodLocker")
  unlockedAttendancePeriods AttendancePeriodLock[] @relation("AttendancePeriodUnlocker")

  @@index([deletedAt])
  @@index([isActive])
  @@map("users")
}

/// System-wide permission definition (e.g. organizations:read).
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// Tenant-scoped role definition (admin, manager, technician, viewer, or custom).
model Role {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  slug           String
  description    String?
  isSystem       Boolean   @default(false)
  isOwner        Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userRoles           UserRole[]
  organizationMembers OrganizationMember[] @relation("MemberPrimaryRole")
  rolePermissions     RolePermission[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@map("roles")
}

/// Links a permission to a tenant-scoped role.
model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Links a User to an Organization with a Role (tenant-scoped user-role assignment).
model UserRole {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  userId         String    @db.Uuid
  roleId         String    @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId, roleId])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, deletedAt])
  @@map("user_roles")
}

enum OrganizationMemberStatus {
  ACTIVE
  SUSPENDED
}

/// Authoritative organization membership with modular access (one row per user per org).
model OrganizationMember {
  id                  String                   @id @default(uuid()) @db.Uuid
  organizationId      String                   @db.Uuid
  userId              String                   @db.Uuid
  primaryRoleId       String                   @db.Uuid
  isOrganizationOwner Boolean                  @default(false)
  status              OrganizationMemberStatus @default(ACTIVE)
  permissionsVersion  Int                      @default(1)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  deletedAt           DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  primaryRole  Role                 @relation("MemberPrimaryRole", fields: [primaryRoleId], references: [id], onDelete: Restrict)
  moduleAccess MemberModuleAccess[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, deletedAt])
  @@map("organization_members")
}

/// Per-member module entitlement (authoritative for non-owner users).
model MemberModuleAccess {
  id                   String   @id @default(uuid()) @db.Uuid
  organizationId       String   @db.Uuid
  organizationMemberId String   @db.Uuid
  moduleKey            String
  enabled              Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationMember OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)

  @@unique([organizationMemberId, moduleKey])
  @@index([organizationId])
  @@index([organizationMemberId])
  @@map("member_module_access")
}

/// Hashed refresh token for JWT session rotation.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Append-only audit trail. Never updated or soft-deleted.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  actorId        String?  @db.Uuid
  action         String
  entityType     String
  entityId       String   @db.Uuid
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

enum WorkDayStatus {
  ACTIVE
  COMPLETED
}

enum WorkBreakStatus {
  ACTIVE
  COMPLETED
}

enum AttendanceReviewStatus {
  PENDING
  APPROVED
}

/// Employee-owned attendance record. Location is captured only at explicit clock actions.
model WorkDay {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @db.Uuid
  userId         String                 @db.Uuid
  status         WorkDayStatus          @default(ACTIVE)
  startedAt      DateTime
  startLatitude  Decimal?               @db.Decimal(9, 6)
  startLongitude Decimal?               @db.Decimal(9, 6)
  startAccuracy  Float?
  endedAt        DateTime?
  endLatitude    Decimal?               @db.Decimal(9, 6)
  endLongitude   Decimal?               @db.Decimal(9, 6)
  endAccuracy    Float?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  reviewStatus   AttendanceReviewStatus @default(PENDING)
  approvedAt     DateTime?
  approvedById   String?                @db.Uuid

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  approvedBy   User?             @relation("WorkDayApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  breaks       WorkBreak[]
  locations    WorkDayLocation[]

  @@index([organizationId, userId, startedAt])
  @@index([organizationId, status])
  @@index([organizationId, reviewStatus])
  @@map("work_days")
}

model WorkBreak {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  workDayId      String          @db.Uuid
  status         WorkBreakStatus @default(ACTIVE)
  startedAt      DateTime
  startLatitude  Decimal?        @db.Decimal(9, 6)
  startLongitude Decimal?        @db.Decimal(9, 6)
  startAccuracy  Float?
  endedAt        DateTime?
  endLatitude    Decimal?        @db.Decimal(9, 6)
  endLongitude   Decimal?        @db.Decimal(9, 6)
  endAccuracy    Float?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workDay      WorkDay      @relation(fields: [workDayId], references: [id], onDelete: Restrict)

  @@index([organizationId, workDayId])
  @@index([organizationId, status])
  @@map("work_breaks")
}

/// A sampled employee location accepted only during that employee's active work day.
model WorkDayLocation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  workDayId      String   @db.Uuid
  recordedAt     DateTime
  latitude       Decimal  @db.Decimal(9, 6)
  longitude      Decimal  @db.Decimal(9, 6)
  accuracy       Float?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workDay      WorkDay      @relation(fields: [workDayId], references: [id], onDelete: Cascade)

  @@unique([workDayId, recordedAt])
  @@index([organizationId, workDayId, recordedAt])
  @@map("work_day_locations")
}

/// Tenant-scoped payroll boundary. An active lock has no unlockedAt value.
model AttendancePeriodLock {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  month          String
  lockedAt       DateTime  @default(now())
  lockedById     String    @db.Uuid
  unlockedAt     DateTime?
  unlockedById   String?   @db.Uuid
  unlockReason   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lockedBy     User         @relation("AttendancePeriodLocker", fields: [lockedById], references: [id], onDelete: Restrict)
  unlockedBy   User?        @relation("AttendancePeriodUnlocker", fields: [unlockedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, month])
  @@index([organizationId, unlockedAt])
  @@map("attendance_period_locks")
}

/// Customer lifecycle status.
enum CustomerStatus {
  ACTIVE
  INACTIVE
  PROSPECT
}

/// Tenant-scoped customer account.
model Customer {
  id                 String         @id @default(uuid()) @db.Uuid
  organizationId     String         @db.Uuid
  name               String
  legalName          String?
  registrationNumber String?
  customerNumber     String
  email              String?
  phone              String?
  address            String?
  city               String?
  country            String?
  notes              String?
  status             CustomerStatus @default(ACTIVE)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contacts     CustomerContact[]
  sites        CustomerSite[]
  equipment    Equipment[]
  serviceCalls ServiceCall[]

  @@unique([organizationId, customerNumber])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@index([organizationId, status])
  @@map("customers")
}

/// Operational site belonging to a customer, such as a quarry or a depot.
model CustomerSite {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  customerId     String    @db.Uuid
  name           String
  address        String?
  city           String?
  contactName    String?
  contactPhone   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  equipment    Equipment[]
  serviceCalls ServiceCall[]

  @@unique([customerId, name])
  @@index([organizationId])
  @@index([customerId, deletedAt])
  @@map("customer_sites")
}

/// Contact person belonging to a customer (tenant-scoped).
model CustomerContact {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  customerId     String    @db.Uuid
  name           String
  email          String?
  phone          String?
  jobTitle       String?
  isPrimary      Boolean   @default(false)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([customerId])
  @@index([customerId, deletedAt])
  @@map("customer_contacts")
}

/// Equipment operational status.
enum EquipmentStatus {
  ACTIVE
  IN_SERVICE
  OUT_OF_SERVICE
  RETIRED
}

/// Tenant-scoped equipment category (forklift, crane, excavator, etc.).
model EquipmentType {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  code           String
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  equipment    Equipment[]
  models       EquipmentCatalogModel[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@map("equipment_types")
}

/// Tenant-scoped manufacturer catalog used when registering equipment assets.
model EquipmentManufacturer {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  key            String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  models       EquipmentCatalogModel[]
  equipment    Equipment[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@map("equipment_manufacturers")
}

/// Tenant-scoped model catalog. A model belongs to one manufacturer and equipment type.
model EquipmentCatalogModel {
  id                      String                @id @default(uuid()) @db.Uuid
  organizationId          String                @db.Uuid
  equipmentManufacturerId String                @db.Uuid
  equipmentTypeId         String                @db.Uuid
  name                    String
  key                     String
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  deletedAt               DateTime?

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  manufacturer          EquipmentManufacturer  @relation(fields: [equipmentManufacturerId], references: [id], onDelete: Restrict)
  equipmentType         EquipmentType          @relation(fields: [equipmentTypeId], references: [id], onDelete: Restrict)
  equipment             Equipment[]

  @@unique([equipmentManufacturerId, equipmentTypeId, key])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@index([equipmentManufacturerId, equipmentTypeId])
  @@map("equipment_models")
}

/// Tenant-scoped equipment asset (machine, vehicle, or tool).
model Equipment {
  id                 String          @id @default(uuid()) @db.Uuid
  organizationId     String          @db.Uuid
  equipmentTypeId    String          @db.Uuid
  customerId         String?         @db.Uuid
  customerSiteId     String?         @db.Uuid
  branchId           String?         @db.Uuid
  name               String
  internalNumber     String
  serialNumber       String?
  manufacturer       String?
  model              String?
  manufacturerId     String?         @db.Uuid
  modelId            String?         @db.Uuid
  year               Int?
  status             EquipmentStatus @default(ACTIVE)
  engineHours        Decimal?        @db.Decimal(10, 2)
  mileage            Int?
  registrationNumber String?
  warrantyEndDate    DateTime?       @db.Date
  location           String?
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  equipmentType EquipmentType @relation(fields: [equipmentTypeId], references: [id], onDelete: Restrict)
  manufacturerRef EquipmentManufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  modelRef        EquipmentCatalogModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerSite  CustomerSite? @relation(fields: [customerSiteId], references: [id], onDelete: SetNull)
  branch        Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  serviceCalls  ServiceCall[]

  @@unique([organizationId, internalNumber])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@index([organizationId, customerSiteId])
  @@index([organizationId, equipmentTypeId])
  @@index([organizationId, manufacturer])
  @@index([organizationId, model])
  @@index([organizationId, manufacturerId])
  @@index([organizationId, modelId])
  @@map("equipment")
}

/// Service call lifecycle status.
enum ServiceCallStatus {
  OPEN
  SCHEDULED
  IN_PROGRESS
  WAITING_FOR_PARTS
  COMPLETED
  CANCELLED
}

/// Service call urgency level.
enum ServiceCallPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Control-center lifecycle (Sprint 4).
enum ServiceCallLifecycleState {
  NEW
  WAITING_ASSIGNMENT
  ASSIGNED
  DRIVING
  WORKING
  WAITING_FOR_PARTS
  WAITING_CUSTOMER
  WAITING_SPECIALIST
  WAITING_MANAGER_CLOSURE
  CLOSED
}

/// Technician visit status within a service call.
enum ServiceCallVisitStatus {
  PLANNED
  ASSIGNED
  DRIVING
  WORKING
  FINISHED
  CANCELLED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
}

/// Tenant-scoped field service work order.
model ServiceCall {
  id                String                    @id @default(uuid()) @db.Uuid
  organizationId    String                    @db.Uuid
  serviceCallNumber String
  title             String
  description       String?
  status            ServiceCallStatus         @default(OPEN)
  lifecycleState    ServiceCallLifecycleState @default(NEW)
  priority          ServiceCallPriority       @default(NORMAL)
  openedAt          DateTime                  @default(now())
  scheduledAt       DateTime?
  completedAt       DateTime?
  customerId        String                    @db.Uuid
  customerSiteId    String?                   @db.Uuid
  equipmentId       String                    @db.Uuid
  branchId          String?                   @db.Uuid
  assignedUserId    String?                   @db.Uuid
  contactName       String?
  contactPhone      String?
  location          String?
  notes             String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  deletedAt         DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerSite CustomerSite?      @relation(fields: [customerSiteId], references: [id], onDelete: SetNull)
  equipment    Equipment          @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  branch       Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  assignedUser User?              @relation("AssignedTechnician", fields: [assignedUserId], references: [id], onDelete: SetNull)
  visits       ServiceCallVisit[]
  workReports  WorkReport[]

  @@unique([organizationId, serviceCallNumber])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, customerId])
  @@index([organizationId, customerSiteId])
  @@index([organizationId, equipmentId])
  @@index([organizationId, assignedUserId])
  @@index([organizationId, openedAt])
  @@map("service_calls")
}

/// Technician visit on a service call (operational store; workflow events remain source of truth for transitions).
model ServiceCallVisit {
  id               String                 @id @default(uuid()) @db.Uuid
  organizationId   String                 @db.Uuid
  serviceCallId    String                 @db.Uuid
  technicianId     String                 @db.Uuid
  sequence         Int
  status           ServiceCallVisitStatus @default(ASSIGNED)
  scheduledStart   DateTime?
  scheduledEnd     DateTime?
  drivingStartedAt DateTime?
  workingStartedAt DateTime?
  finishedAt       DateTime?
  notes            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  deletedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  serviceCall  ServiceCall  @relation(fields: [serviceCallId], references: [id], onDelete: Restrict)
  technician   User         @relation("VisitTechnician", fields: [technicianId], references: [id], onDelete: Restrict)
  workReports  WorkReport[]

  @@unique([serviceCallId, sequence])
  @@index([organizationId])
  @@index([organizationId, serviceCallId])
  @@index([organizationId, technicianId])
  @@index([organizationId, deletedAt])
  @@map("service_call_visits")
}

/// Tenant-managed catalog used only to document parts used in field work reports.
model WorkReportPartCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parts        WorkReportPart[]

  @@unique([organizationId, name])
  @@index([organizationId, deletedAt])
  @@map("work_report_part_categories")
}

model WorkReportPart {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  categoryId     String   @db.Uuid
  name           String
  partNumber     String?
  unit           String   @default("יח׳")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category     WorkReportPartCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reportItems  WorkReportPartItem[]

  @@index([organizationId, categoryId, deletedAt])
  @@map("work_report_parts")
}

model WorkReport {
  id                     String   @id @default(uuid()) @db.Uuid
  organizationId         String   @db.Uuid
  serviceCallId          String   @db.Uuid
  visitId                String   @db.Uuid
  reportNumber           String
  workDescription        String   @default("")
  customerRepresentative String?
  customerRepresentativeRole String?
  signatureStrokes       Json?
  signedAt               DateTime?
  technicianId           String   @db.Uuid
  lastEditedById         String?  @db.Uuid
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  deletedAt              DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  serviceCall  ServiceCall        @relation(fields: [serviceCallId], references: [id], onDelete: Restrict)
  visit        ServiceCallVisit   @relation(fields: [visitId], references: [id], onDelete: Restrict)
  technician   User               @relation("WorkReportTechnician", fields: [technicianId], references: [id], onDelete: Restrict)
  lastEditedBy User?              @relation("WorkReportEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  parts        WorkReportPartItem[]
  media        WorkReportMedia[]

  @@unique([organizationId, reportNumber])
  @@unique([visitId])
  @@index([organizationId, serviceCallId, deletedAt])
  @@map("work_reports")
}

model WorkReportPartItem {
  id           String   @id @default(uuid()) @db.Uuid
  reportId     String   @db.Uuid
  partId       String   @db.Uuid
  quantity     Decimal  @db.Decimal(12, 3)
  createdAt    DateTime @default(now())

  report WorkReport     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  part   WorkReportPart @relation(fields: [partId], references: [id], onDelete: Restrict)

  @@unique([reportId, partId])
  @@map("work_report_part_items")
}

model WorkReportMedia {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  reportId       String   @db.Uuid
  mediaType      String
  fileName       String
  mimeType       String
  storageKey     String   @unique
  sizeBytes      Int
  createdAt      DateTime @default(now())
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  report       WorkReport   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([organizationId, reportId, deletedAt])
  @@map("work_report_media")
}

/// Append-only workflow event stream (service-call aggregate).
model WorkflowEvent {
  id             String   @id @db.Uuid
  organizationId String   @db.Uuid
  aggregateType  String
  aggregateId    String   @db.Uuid
  type           String
  payload        Json
  occurredAt     DateTime
  actorId        String?  @db.Uuid
  correlationId  String
  causationId    String?  @db.Uuid
  sequence       Int
  idempotencyKey String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, aggregateId, sequence])
  @@index([organizationId, aggregateId])
  @@index([organizationId, idempotencyKey])
  @@map("workflow_events")
}
