{
  "expo": {
    "name": "AMAROK ONE",
    "slug": "amarok-one-mobile",
    "owner": "amaroksoftware",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "platforms": ["ios", "android", "web"],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#101010"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amarokone.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Attach visit photos stored on this device for your records.",
        "NSLocationWhenInUseUsageDescription": "AMAROK ONE records your location only during an active work day for attendance and field travel.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "AMAROK ONE can continue recording your location in the background only during an active work day.",
        "UIBackgroundModes": ["location"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#101010"
      },
      "package": "com.amarokone.mobile",
      "versionCode": 1,
      "permissions": ["android.permission.READ_MEDIA_IMAGES", "android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach visit photos stored on this device for your records."
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "AMAROK ONE records your location only during an active work day for attendance and field travel.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "0c83bdd6-6c4a-432d-862d-edaaf68c837c"
      }
    }
  }
}
