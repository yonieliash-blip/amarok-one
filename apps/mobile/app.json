{
  "expo": {
    "name": "AMAROK ONE",
    "slug": "amarok-one-mobile",
    "owner": "amaroksoftware",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "platforms": ["ios", "android", "web"],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffc928"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amarokone.mobile",
      "buildNumber": "7",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "הוספת תמונות ביקור השמורות במכשיר לצורך תיעוד העבודה.",
        "NSLocationWhenInUseUsageDescription": "AMAROK ONE מתעדת את מיקומך רק במהלך יום עבודה פעיל, לצורך נוכחות ונסיעות שטח.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "AMAROK ONE יכולה להמשיך לתעד את מיקומך ברקע רק במהלך יום עבודה פעיל.",
        "UIBackgroundModes": ["location"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffc928"
      },
      "package": "com.amarokone.mobile",
      "versionCode": 1,
      "permissions": ["android.permission.READ_MEDIA_IMAGES"]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "הוספת תמונות ביקור השמורות במכשיר לצורך תיעוד העבודה."
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "AMAROK ONE מתעדת את מיקומך רק במהלך יום עבודה פעיל, לצורך נוכחות ונסיעות שטח.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "0c83bdd6-6c4a-432d-862d-edaaf68c837c"
      }
    }
  }
}
