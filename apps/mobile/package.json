{
  "name": "@amarok-one/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "scripts": {
    "dev": "expo start",
    "build": "tsc --noEmit -p tsconfig.json",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint App.tsx src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "clean": "rimraf dist .expo",
    "eas-build-pre-install": "cd ../.. && corepack enable && corepack prepare pnpm@10.12.4 --activate && pnpm install --frozen-lockfile",
    "eas-build-post-install": "cd ../.. && pnpm exec turbo run build --filter=@amarok-one/types... --filter=@amarok-one/permissions... --filter=@amarok-one/utils...",
    "assets:fix-store": "node scripts/fix-store-assets.mjs",
    "eas:whoami": "pnpm dlx eas-cli@16 whoami",
    "eas:init": "pnpm dlx eas-cli@16 init",
    "eas:build:ios": "pnpm dlx eas-cli@16 build --platform ios --profile production"
  },
  "dependencies": {
    "@amarok-one/permissions": "workspace:*",
    "@amarok-one/types": "workspace:*",
    "@amarok-one/utils": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.26",
    "expo": "~54.0.33",
    "expo-image-picker": "~17.0.8",
    "expo-secure-store": "~15.0.7",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@amarok-one/config": "workspace:*",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^10.6.0",
    "rimraf": "^6.0.1",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "vitest": "^3.2.4"
  }
}
