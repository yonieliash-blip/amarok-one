  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "dev": "expo start",
    "build": "tsc --noEmit -p tsconfig.json",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint App.tsx src",
