# AMAROK ONE — Production Environment Template
#
# Copy to `.env` at the repository root for Docker Compose, or configure these
# values in AWS Secrets Manager / ECS task definitions / Parameter Store.
#
# NEVER commit `.env` with real secrets to Git.

# ── Database (AWS RDS PostgreSQL) ────────────────────────────────
# Example RDS endpoint — replace with your instance hostname.
DATABASE_URL=postgresql://amarok:CHANGE_ME@amarok-one.xxxxxxxxxxxx.eu-west-1.rds.amazonaws.com:5432/amarok_one?schema=public&sslmode=require

# ── API ──────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Public web origin (ALB / CloudFront URL). Must match the browser origin exactly.
CORS_ORIGIN=https://app.example.com

# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME-generate-a-random-string-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME-generate-a-different-random-string-at-least-32-ch
JWT_REFRESH_EXPIRES_IN=7d

LOG_LEVEL=info

# Optional: set in production to allow GET /health/db with header X-Health-Token
# HEALTH_DB_TOKEN=CHANGE_ME-generate-a-random-string

# ── Web (Vite build-time — baked into the static bundle) ─────────
# Public API URL reachable from the browser (ALB / API subdomain).
VITE_API_URL=https://api.example.com

# ── Optional: one-time seed (local / staging only) ───────────────
# Do not set weak passwords in production. Run seed manually after first deploy.
# SEED_ADMIN_PASSWORD=

# ── AWS deployment reference (not read by the app) ───────────────
# AWS_REGION=eu-west-1
# ECR_API_REPOSITORY=amarok-one-api
# ECR_WEB_REPOSITORY=amarok-one-web
# ECS_CLUSTER=amarok-one-prod
# ECS_API_SERVICE=amarok-one-api
# ECS_WEB_SERVICE=amarok-one-web
