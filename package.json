{
  "name": "amarok-one",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ERP and Field Service Management System for Construction Equipment and Forklifts",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:root": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rimraf node_modules/.cache",
    "db:up": "docker compose -f infrastructure/docker/docker-compose.postgres.yml up -d --wait",
    "db:down": "docker compose -f infrastructure/docker/docker-compose.postgres.yml down",
    "db:setup": "pnpm --filter @amarok-one/api db:setup",
    "db:generate": "pnpm --filter @amarok-one/api db:generate",
    "db:migrate": "pnpm --filter @amarok-one/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @amarok-one/api db:migrate:deploy",
    "db:seed": "pnpm --filter @amarok-one/api db:seed",
    "db:studio": "pnpm --filter @amarok-one/api db:studio",
    "dev:api": "pnpm --filter @amarok-one/api dev",
    "build:prod": "turbo run build",
    "docker:build": "docker compose --env-file infrastructure/docker/compose.env -f infrastructure/docker/docker-compose.yml build",
    "docker:up": "docker compose --env-file infrastructure/docker/compose.env -f infrastructure/docker/docker-compose.yml up -d --wait",
    "docker:down": "docker compose --env-file infrastructure/docker/compose.env -f infrastructure/docker/docker-compose.yml down",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^17.7.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.5.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0"
  }
}
