# Copy to staging.env on the server. Never commit staging.env.
STAGING_API_DOMAIN=staging-api.amarok-ce.com
STAGING_WEB_DOMAIN=staging.amarok-ce.com

POSTGRES_USER=amarok
POSTGRES_DB=amarok_one
# Use a long URL-safe random value so it can be embedded safely in DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_VALUE

# Use separate random values of at least 32 characters.
JWT_SECRET=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_RANDOM_VALUE_AT_LEAST_32_CHARACTERS

JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
LOG_LEVEL=info
