# Docker Compose variable substitution (local stack only).
# Used by: docker compose --env-file infrastructure/docker/compose.env ...
CORS_ORIGIN=http://localhost:8080
VITE_API_URL=http://localhost:3000
JWT_SECRET=local-docker-jwt-secret-minimum-32-characters-long
JWT_REFRESH_SECRET=local-docker-refresh-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
LOG_LEVEL=info
