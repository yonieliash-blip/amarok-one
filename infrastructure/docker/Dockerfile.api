# syntax=docker/dockerfile:1

FROM node:20-alpine AS base
RUN apk add --no-cache openssl
RUN corepack enable && corepack prepare pnpm@10.12.4 --activate
WORKDIR /app

FROM base AS pruner
RUN npm install -g turbo@2.10.5
COPY . .
RUN turbo prune @amarok-one/api --docker

FROM base AS builder
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile
COPY --from=pruner /app/out/full/ .
RUN pnpm turbo run build --filter=@amarok-one/api
RUN pnpm deploy --filter=@amarok-one/api --prod --legacy /deploy/api

FROM node:20-alpine AS runner
RUN apk add --no-cache openssl wget
RUN npm install -g prisma@6.19.3
WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /deploy/api ./
COPY --from=builder /app/apps/api/prisma ./prisma
RUN prisma generate --schema=./prisma/schema.prisma

COPY infrastructure/docker/entrypoint.api.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD wget -qO- http://127.0.0.1:${PORT:-3000}/health || exit 1

ENTRYPOINT ["/entrypoint.sh"]
