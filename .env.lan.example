# Optional LAN / mobile-device overlay for local development.
#
# Normal laptop development uses localhost only (.env) and does not need this file.
#
# Setup (same Wi-Fi testing from phone/tablet or another machine):
#   1. Copy this file to .env.lan.local at the repository root (gitignored).
#   2. Replace YOUR_LAN_IP with your machine's Wi-Fi IPv4 address.
#   3. Start LAN dev servers: pnpm dev:api:lan  and  pnpm dev:web:lan
#   4. Open http://YOUR_LAN_IP:5173 on the device.
#
# Revert to normal dev anytime with: pnpm dev:api  and  pnpm dev:web

VITE_API_URL=http://YOUR_LAN_IP:3000
CORS_ORIGIN=http://localhost:5173,http://YOUR_LAN_IP:5173
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:3000
